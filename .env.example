# Copy to .env and fill in. Never commit .env.

# Postgres. On Neon use the pooled connection string here...
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"
# ...and the direct (non-pooled) one here, for migrations.
DIRECT_URL="postgresql://user:password@ep-example.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Random secret for Auth.js: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""

# SMTP server for sign-in emails, e.g. smtp://user:password@smtp.example.com:587
# Leave unset in development to print sign-in links in the terminal instead.
# EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
# EMAIL_FROM="Cambridge Pub Map <pubs@example.com>"
